{
  "name": "@graupel/model-data",
  "version": "0.5.0",
  "private": true,
  "description": "Graupel model data generated by graupel-gen: model catalogue, domains, regions, chain zones, quantity registry",
  "license": "CC-BY-4.0 AND MPL-2.0",
  "files": [
    "*.json",
    "*.geojson",
    "LICENSE",
    "LICENSES",
    "REUSE.toml",
    "THIRD_PARTY_LICENSES.md"
  ],
  "exports": {
    "./model_catalogue.json": "./model_catalogue.json",
    "./model_domains.json": "./model_domains.json",
    "./regions.geojson": "./regions.geojson",
    "./chain_zones.json": "./chain_zones.json",
    "./chain_zones.geojson": "./chain_zones.geojson",
    "./quantities.json": "./quantities.json",
    "./resolver_cases.json": "./resolver_cases.json",
    "./package.json": "./package.json"
  }
}
