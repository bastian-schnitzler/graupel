{
  "name": "@graupel/domain-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Model Domain Viewer: Gebiete der Wettermodelle und Zonen der Auto-Ketten auf einer Karte (statische Seite)",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/prebuild.mjs",
    "build": "node scripts/build.mjs",
    "start": "pnpm build && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "licenses": "node scripts/third-party.mjs",
    "test": "vitest run",
    "lint": "eslint src scripts test e2e sw.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@graupel/model-data": "workspace:*",
    "@maplibre/maplibre-gl-leaflet": "0.0.22",
    "leaflet": "1.9.4",
    "maplibre-gl": "4.7.1"
  }
}
